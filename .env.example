# Copy this file to .env and adjust values for local development.
# .env is gitignored — never commit real credentials.

POSTGRES_USER=cashflow_local
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB_LANCAMENTOS=lancamentos_db
POSTGRES_DB_CONSOLIDADO=consolidado_db

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=cashflow.entries
KAFKA_DLQ_TOPIC=cashflow.entries.dlq
KAFKA_CONSUMER_GROUP=consolidado-service

CORS_ALLOWED_ORIGIN=http://localhost:3000
