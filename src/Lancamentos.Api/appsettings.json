{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "LancamentosDb": "Host=localhost;Port=5432;Database=lancamentos_db;Username=cashflow;Password=cashflow"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "cashflow.entries",
    "ConsumerGroup": "consolidado-service"
  },
  "Outbox": {
    "PollIntervalSeconds": 2
  },
  "Features": {
    "EnableBackgroundWorkers": true
  }
}
