{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "LancamentosDb": ""
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "cashflow.entries",
    "ConsumerGroup": "consolidado-service"
  },
  "Outbox": {
    "PollIntervalSeconds": 2
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:3000"
  },
  "Features": {
    "EnableBackgroundWorkers": true
  }
}
